# Browser and Netlify build. Keep both blank to run the demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Netlify Functions only. The Supabase settings also enable staff invitations.
# Never prefix server variables with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
BUSINESS_TIMEZONE=Asia/Kolkata
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
REMINDER_RECIPIENTS=
SITE_URL=
